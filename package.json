{
  "name": "word-reading-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Word Reading 后端 API：Express 5 + MongoDB + 本地 COCA 词库 + DeepSeek",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:dictionary": "node scripts/build-dictionary.mjs",
    "build:basic-words": "node scripts/build-basic-words.mjs",
    "seed:fixtures": "node scripts/seed-test-fixtures.mjs",
    "clean:readings": "node scripts/clean-debug-readings.mjs",
    "batch:generate": "node scripts/batch-generate.mjs",
    "fixtures:export": "node scripts/export-replay-fixtures.mjs",
    "replay": "node scripts/replay-suite.mjs",
    "replay:report": "node scripts/replay-suite.mjs --report",
    "replay:update": "node scripts/replay-suite.mjs --update",
    "calibrate": "node scripts/calibrate-standards.mjs",
    "fetch:ocr": "node scripts/fetch-ocr-model.mjs"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "mammoth": "1.13.0",
    "mongoose": "8.24.7",
    "multer": "2.5.0",
    "openai": "7.45.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "vitest": "5.0.5"
  }
}
