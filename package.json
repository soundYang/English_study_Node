{
  "name": "word-reading-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Word Reading 后端 API：Express 5 + MongoDB + 本地 COCA 词库 + DeepSeek",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
