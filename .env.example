# 服务
PORT=3000
# 允许的浏览器来源，多个用逗号分隔（不带结尾斜杠）。
# 按源精确匹配（协议 + 主机 + 端口）：localhost 与 127.0.0.1 在浏览器眼里是两个源，
# vite 启动日志里打印的每个网卡地址也都是各自独立的源，用到哪个就追加哪个。
# 局域网联调示例：CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://192.0.2.16:5173
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

# 数据库
MONGODB_URI=mongodb://127.0.0.1:27017/english_code_study_MANGODB

# 用户（MVP 无登录，所有请求归属这个用户）
DEFAULT_USER_ID=local-user

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=60000
# 单次生成的输出上限（上限不产生费用，按实际 completion_tokens 计费）
MAX_OUTPUT_TOKENS=8192

# 生成策略
# segmented = 规划 → 分段闭环 → 收尾（默认）；whole = 旧的一次性整篇生成
GENERATION_STRATEGY=segmented
# 分段并发数（4 是成本/延迟平衡点）
SEGMENT_CONCURRENCY=4
# 每段允许的重写次数（不含首轮与最后的「更简单说法」兜底）
SEGMENT_MAX_ATTEMPTS=2
# 分段路径温度（写约束性文本时 0.8 会制造违规）
SEGMENT_TEMPERATURE=0.5
VOCABULARY_THRESHOLD=20
MAX_REPAIR_ROUNDS=2
# 篇幅压缩的独立轮数（不占用上面的额度）
MAX_LENGTH_ROUNDS=1
# 偏短扩写的独立轮数。默认 0：只记 aiMeta.lengthStatus，不追加调用
# 开启后会把「短于验收下限」的文章补 1–3 句，仍偏短则照旧放行
MAX_EXPAND_ROUNDS=0
# 生词预算（md/41 / md/42）：allowNewWords 自动时最终模式默认开，其余默认关；
# 打开后按难度取 medium 3 / hard 5（easy 恒为 0）。取消注释会把它变成**全局覆盖**，
# 三档压成同一个数——只用于调试与回归对比；它不能凭空打开开关，开关没开时预算仍是 0
# MAX_UNKNOWN_WORDS=5

# 个人词库（md/44）
# 每个用户最多能有多少个词。只对「新建」计数：合并已有词、改状态都不占名额，
# 所以到达上限后仍可以导入已收录过的词。0 或负数 = 不限制
WORD_LIBRARY_LIMIT=5000

# 限流
# 总开关。影响 POST /readings/generate 与 POST /api/words/check；
# 测试环境即使写成 true 也会被 setup.js 关掉（需要验证限流的用例自己开）
RATE_LIMIT_ENABLED=true
# 只有生成接口挂限流（次 / 分钟）：它是唯一天然会调付费模型的路由
RATE_LIMIT_GENERATE=20

# 每日额度（md/35）
# 总开关。前端设备 ID（X-Device-Id）已上线，默认打开。
# 本地批量采样（3100–3102）要显式关掉，否则网络指纹桶 10 次/天会把采样打成 429：
#   DAILY_QUOTA_ENABLED=false DEFAULT_USER_ID=fixture-rich PORT=3100 node src/server.js
DAILY_QUOTA_ENABLED=true
# 账号 / 设备 / 网络指纹 每日次数
DAILY_QUOTA_ACCOUNT=3
DAILY_QUOTA_DEVICE=3
DAILY_QUOTA_NETWORK=10
# 部署在 nginx / Cloudflare 后面时必须配置，否则 req.ip 全是反代地址，
# 网络指纹退化成全站一个桶。取值：true / false / 跳数（1、2）/ loopback
TRUST_PROXY=false

# 全局免费 token 预算（md/36）
# 按每一次真实模型调用累计（含失败 / 重试 / 取消），到顶后所有生成返回
# 503 FREE_BUDGET_EXHAUSTED，提示用户接入自己的 API Key
TOKEN_BUDGET_ENABLED=true
# 免费池总量（token）。2 亿 ≈ 按实测均值 4.2 万 token/篇 约 4700 篇
FREE_TOKEN_BUDGET=200000000

# 用户自备 API Key（md/43）
# 总开关。生效还需要 USER_API_KEY_SECRET；缺 Secret 时按关闭处理
USER_API_KEY_ENABLED=true
# 加密主密钥：node scripts/gen-user-key-secret.mjs 生成，32 字节 base64
# 丢失后存量的 Key 无法解密，用户需要重新导入；换密钥时把旧值填到 _PREVIOUS
USER_API_KEY_SECRET=
USER_API_KEY_SECRET_PREVIOUS=
# 导入时的上游校验超时（毫秒）
USER_API_KEY_VERIFY_TIMEOUT_MS=8000
# 导入 / 删除 / 校验共用的限流（次 / 分钟 / IP）
RATE_LIMIT_API_KEY=5

# 管理员后台（md/37）
# 只有一个账号，凭据放环境变量：不建 admins 表，改密码 = 重新生成哈希并重启
# 两项都配置了才挂载 /api/admin/*；缺任一项时整个前缀 404
ADMIN_USERNAME=
# 生成方式：node scripts/hash-admin-password.mjs '你的密码'
# 存 scrypt 字符串，代码与仓库里永远没有明文。上线前请换掉任何弱口令
ADMIN_PASSWORD_HASH=
