# 服务
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# 数据库
MONGODB_URI=mongodb://127.0.0.1:27017/english_code_study_MANGODB

# 用户（MVP 无登录，所有请求归属这个用户）
DEFAULT_USER_ID=local-user

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=60000
# 单次生成的输出上限（上限不产生费用，按实际 completion_tokens 计费）
MAX_OUTPUT_TOKENS=8192

# 生成策略
# segmented = 规划 → 分段闭环 → 收尾（默认）；whole = 旧的一次性整篇生成
GENERATION_STRATEGY=segmented
# 分段并发数（4 是成本/延迟平衡点）
SEGMENT_CONCURRENCY=4
# 每段允许的重写次数（不含首轮与最后的「更简单说法」兜底）
SEGMENT_MAX_ATTEMPTS=2
# 分段路径温度（写约束性文本时 0.8 会制造违规）
SEGMENT_TEMPERATURE=0.5
VOCABULARY_THRESHOLD=20
MAX_REPAIR_ROUNDS=2
# 篇幅压缩的独立轮数（不占用上面的额度）
MAX_LENGTH_ROUNDS=1
# 生词预算默认按难度取：easy 0 / medium 3 / hard 5（src/modules/readings/level-limits.js）
# 取消注释会把它变成**全局覆盖**，三档压成同一个数——只用于调试与回归对比
# MAX_UNKNOWN_WORDS=5
# 基础词汇白名单取 COCA 前多少名
BASIC_WORDS_RANK=3000

# 限流
RATE_LIMIT_DICTIONARY=60
RATE_LIMIT_GENERATE=20
RATE_LIMIT_GLOBAL=300
